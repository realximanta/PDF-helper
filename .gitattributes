# Git attributes — https://git-scm.com/docs/gitattributes
# Complements .editorconfig (which most editors honor) by forcing the same
# rules on Git itself, so a Windows contributor can't accidentally commit
# CRLF line endings that break CI on Linux.

# ============================================================
# Default — normalize all text files to LF on commit
# ============================================================
* text=auto eol=lf

# ============================================================
# Explicit text types — enforce LF in the repository
# ============================================================
*.kt      text eol=lf
*.kts     text eol=lf
*.java    text eol=lf
*.xml     text eol=lf
*.gradle  text eol=lf
*.properties text eol=lf
*.pro     text eol=lf
*.md      text eol=lf
*.yml     text eol=lf
*.yaml    text eol=lf
*.json    text eol=lf
*.html    text eol=lf
*.css     text eol=lf
*.js      text eol=lf
*.sh      text eol=lf
.gitignore     text eol=lf
.gitattributes text eol=lf
.editorconfig  text eol=lf
LICENSE        text eol=lf

# ============================================================
# Windows scripts — CRLF required for .bat/.cmd/.ps1 to run
# (not present in repo today, but prevents future headaches)
# ============================================================
*.bat     text eol=crlf
*.cmd     text eol=crlf
*.ps1     text eol=crlf

# ============================================================
# Binary — never diff, never merge as text
# ============================================================
*.png     binary
*.jpg     binary
*.jpeg    binary
*.gif     binary
*.webp    binary
*.ico     binary
*.ttf     binary
*.otf     binary
*.woff    binary
*.woff2   binary
*.pdf     binary
*.zip     binary
*.jar     binary
*.aar     binary
*.jks     binary
*.keystore binary
*.apk     binary
*.aab     binary
*.dex     binary

# ============================================================
# Generated / build output — excluded from language stats on GitHub
# ============================================================
app/build/**     linguist-generated=true
build/**         linguist-generated=true
.gradle/**       linguist-generated=true
*.apk            linguist-detectable=false
*.aab            linguist-detectable=false

# ============================================================
# Documentation — mark GitHub as documentation (not code) for stats
# ============================================================
docs/**    linguist-documentation
*.md       linguist-documentation

# ============================================================
# Web folder — vendored third-party is none today, but flag the intent
# ============================================================
js/**      linguist-vendored=false
data/**    linguist-documentation

# ============================================================
# Diff drivers — show a friendly message instead of binary blob noise
# ============================================================
*.pdf diff=astextplain
